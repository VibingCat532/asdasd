{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm run install:all",
  "framework": null,
  "outputDirectory": "frontend/build",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "backend-node/src/db/schema.sql"
    },
    "api/index.js": {
      "includeFiles": "backend-node/src/db/schema.sql"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
